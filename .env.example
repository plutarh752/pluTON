# ── База данных ──
# Neon connection string (sslmode=require). Prisma ходит в Neon через driver adapter по 443,
# а НЕ по прямому TCP 5432 — см. CLAUDE.md §1 (на части сетей 5432 недоступен).
# Локальный docker-compose поднимает такую же БД по 5432 — тогда используй строку из compose.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ── Шифрование секретов (GIFT_SATELLITE_KEY/TONAPI_KEY/TELEGRAM_* хранятся в Postgres, не в .env) ──
# Сгенерируй ОДИН раз, одинаковый на Vercel и Railway (оба читают/пишут секреты через общую БД):
#   openssl rand -hex 32
# Сами ключи вводятся один раз через веб-форму /settings в самом приложении — сюда их вписывать не нужно
# и НЕ нужно передавать при шаринге папки с кодом (без этого ключа хранимые в БД секреты нечем расшифровать).
SETTINGS_ENCRYPTION_KEY=""

# ── tonapi.io ──
# Ключ (опционально, бесплатный тир 1 RPS работает и без него) вводится через /settings, не сюда.
TONAPI_BASE_URL="https://tonapi.io/v2"

# ── gift-satellite.dev (ОСНОВНОЙ источник PluTON v2: мультимаркетные листинги) ──
# Ключ создаётся в профиле пользователя на gift-satellite.dev и вводится через /settings в приложении
# (обязателен — без него приложение недоступно, см. src/lib/requireConfigured.ts), не сюда.
# BASE_URL по умолчанию https://gift-satellite.dev/api (подтверждён probe'ом); переопредели при смене хоста.
GIFT_SATELLITE_BASE_URL="https://gift-satellite.dev/api"

# ── Прод-триггер веб → воркер (Vercel → Railway) ──
# WORKER_URL задаётся ТОЛЬКО на вебе (Vercel): публичный URL воркера на Railway.
#   Если пусто (локально) — /api/scan и /api/rescore запускают воркер через spawn.
#   Если задан (прод)     — шлют HTTP-сигнал POST {WORKER_URL}/run?job=…
WORKER_URL=""
# Общий секрет: одинаковый на вебе (Vercel) и на воркере (Railway). Сгенерируй случайный.
WORKER_TOKEN=""

# ── Portals (вкладка «Объёмы» — РЕАЛЬНЫЙ объём/продажи; CLAUDE.md инвариант 9) ──
# TELEGRAM_API_ID/TELEGRAM_API_HASH (с my.telegram.org) и TELEGRAM_SESSION вводятся через /settings в
# приложении, не сюда — воркер читает их из общей БД (расшифровывает SETTINGS_ENCRYPTION_KEY выше) и
# подмешивает в env Python-сайдкара на спавне. TELEGRAM_SESSION генерится ОДНОРАЗОВО локально:
#   npm run portals:login   (ЛИЧНЫЙ ввод номера телефона + кода) → вставь строку в /settings. НЕ коммить.
# tma истекает → health-check при старте воркера/прогона кричит в лог (npm run portals:health).
# Опц. тюнинг сбора объёма (дефолты разумные):
# PORTALS_RUN_BUDGET_SEC="540"   # общий бюджет времени прогона (сек)
# PORTALS_MAX_PAGES="20"         # кап пагинации sales-feed на коллекцию
# PORTALS_THROTTLE_SEC="0.35"    # пауза между запросами Portals
# PYTHON_BIN="python3"           # интерпретатор для сайдкара
